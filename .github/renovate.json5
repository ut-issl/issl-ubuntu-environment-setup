{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  minimumReleaseAge: '3 days',
  customManagers: [
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$substringBefore(uses, "@") = "commitizen-tools/setup-cz"].{ "currentValue": with.version }',
      ],
      depNameTemplate: 'commitizen-tools/commitizen',
      datasourceTemplate: 'pypi',
      packageNameTemplate: 'commitizen',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$exists(env.ACTIONLINT_VERSION)].{ "currentValue": env.ACTIONLINT_VERSION }',
      ],
      depNameTemplate: 'rhysd/actionlint',
      datasourceTemplate: 'go',
      packageNameTemplate: 'github.com/rhysd/actionlint',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$exists(env.RENOVATE_VERSION)].{ "currentValue": env.RENOVATE_VERSION }',
      ],
      depNameTemplate: 'renovatebot/renovate',
      datasourceTemplate: 'npm',
      packageNameTemplate: 'renovate',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$exists(env.SHELLCHECK_PY_VERSION)].{ "currentValue": env.SHELLCHECK_PY_VERSION }',
      ],
      depNameTemplate: 'shellcheck-py/shellcheck-py',
      datasourceTemplate: 'pypi',
      packageNameTemplate: 'shellcheck-py',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$exists(env.SHFMT_VERSION)].{ "currentValue": env.SHFMT_VERSION }',
      ],
      depNameTemplate: 'mvdan/sh',
      datasourceTemplate: 'go',
      packageNameTemplate: 'mvdan.cc/sh/v3',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$substringBefore(uses, "@") = "rvben/rumdl"].{ "currentValue": with.version }',
      ],
      depNameTemplate: 'rvben/rumdl',
      datasourceTemplate: 'pypi',
      packageNameTemplate: 'rumdl',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$substringBefore(uses, "@") = "lycheeverse/lychee-action"].{ "currentValue": with.lycheeVersion }',
      ],
      depNameTemplate: 'lycheeverse/lychee',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^lychee-(?<version>v\\d+\\.\\d+\\.\\d+)$',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$exists(env.JSON5_VERSION)].{ "currentValue": env.JSON5_VERSION }',
      ],
      depNameTemplate: 'json5/json5',
      datasourceTemplate: 'npm',
      packageNameTemplate: 'json5',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$substringBefore(uses, "@") = "tombi-toml/setup-tombi"].{ "currentValue": with.version }',
      ],
      depNameTemplate: 'tombi-toml/tombi',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$exists(env.YAMLLINT_VERSION)].{ "currentValue": env.YAMLLINT_VERSION }',
      ],
      depNameTemplate: 'adrienverge/yamllint',
      datasourceTemplate: 'pypi',
      packageNameTemplate: 'yamllint',
    },
    {
      customType: 'jsonata',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.ya?ml$/',
      ],
      fileFormat: 'yaml',
      matchStrings: [
        'jobs.*.steps[$exists(env.RUFF_VERSION)].{ "currentValue": env.RUFF_VERSION }',
      ],
      depNameTemplate: 'astral-sh/ruff',
      datasourceTemplate: 'pypi',
      packageNameTemplate: 'ruff',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/test\\.ya?ml$/',
      ],
      matchStrings: [
        'user-ref: (?<currentDigest>[a-f0-9]{40}) # (?<currentValue>\\S+)',
      ],
      autoReplaceStringTemplate: 'user-ref: {{{newDigest}}} # {{{currentValue}}}',
      datasourceTemplate: 'git-refs',
      depNameTemplate: 'ut-issl/personal-nix-config-template',
      packageNameTemplate: 'https://github.com/ut-issl/personal-nix-config-template',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'github-actions',
      ],
      matchDepTypes: [
        'action',
      ],
      allowedVersions: '/^v?\\d+\\.\\d+\\.\\d+$/',
    },
    {
      matchManagers: [
        'pre-commit',
      ],
      matchDepNames: [
        'lycheeverse/lychee',
      ],
      versioning: 'regex:^lychee-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      matchDepNames: [
        'commitizen-tools/commitizen',
      ],
      groupName: 'commitizen',
    },
    {
      matchDepNames: [
        'lycheeverse/lychee',
      ],
      groupName: 'lychee',
    },
    {
      matchDepNames: [
        'rvben/rumdl',
        'rvben/rumdl-pre-commit',
      ],
      groupName: 'rumdl',
    },
    {
      matchDepNames: [
        'astral-sh/ruff',
        'astral-sh/ruff-pre-commit',
      ],
      groupName: 'ruff',
    },
    {
      description: 'Compare ShellCheck versions as PEP 440, as Renovate would otherwise take its four-part hook tags such as v0.11.0.1-1 for prereleases and never offer them',
      matchDepNames: [
        'shellcheck-py/shellcheck-py',
      ],
      versioning: 'pep440',
      groupName: 'shellcheck',
    },
    {
      description: 'Compare shfmt hook versions as PEP 440, as Renovate would otherwise take its -N tags such as v3.14.1-1 for prereleases and never offer them',
      matchDepNames: [
        'scop/pre-commit-shfmt',
      ],
      versioning: 'pep440',
    },
    {
      matchDepNames: [
        'mvdan/sh',
        'scop/pre-commit-shfmt',
      ],
      groupName: 'shfmt',
    },
    {
      matchDepNames: [
        'tombi-toml/setup-tombi',
        'tombi-toml/tombi',
        'tombi-toml/tombi-pre-commit',
      ],
      groupName: 'tombi',
    },
    {
      matchDepNames: [
        'crate-ci/typos',
      ],
      groupName: 'typos',
    },
    {
      matchDepNames: [
        'adrienverge/yamllint',
      ],
      groupName: 'yamllint',
    },
    {
      matchDepNames: [
        'ghcr.io/zizmorcore/zizmor',
      ],
      overrideDatasource: 'github-releases',
      overridePackageName: 'zizmorcore/zizmor',
      minimumReleaseAge: '4 days',
      pinDigests: false,
    },
    {
      matchFileNames: [
        '.github/workflows/**',
        '.pre-commit-config.yaml',
      ],
      labels: [
        'automated',
        'dev-dependencies',
      ],
    },
    {
      matchFileNames: [
        '.github/workflows/**',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
    },
    {
      matchDepNames: [
        'renovatebot/renovate',
      ],
      extends: [
        'schedule:weekly',
      ],
    },
    {
      matchDepNames: [
        'renovatebot/renovate',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      automerge: true,
    },
    {
      matchManagers: [
        'pre-commit',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
    },
    {
      matchDepNames: [
        'ut-issl/personal-nix-config-template',
      ],
      minimumReleaseAge: '0 days',
      automerge: true,
    },
  ],
  'git-submodules': {
    enabled: true,
  },
  'pre-commit': {
    enabled: true,
  },
  nix: {
    enabled: true,
  },
  lockFileMaintenance: {
    automerge: true,
    minimumReleaseAge: '0 days',
    addLabels: [
      'update::patch',
    ],
  },
  labels: [
    'automated',
    'dependencies',
  ],
}
