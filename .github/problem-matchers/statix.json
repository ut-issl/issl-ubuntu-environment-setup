{
  "problemMatcher": [
    {
      "owner": "statix-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.+)>(\\d+):(\\d+):E:(\\d+):(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "statix-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^(.+)>(\\d+):(\\d+):W:(\\d+):(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "statix-hint",
      "severity": "notice",
      "pattern": [
        {
          "regexp": "^(.+)>(\\d+):(\\d+):I:(\\d+):(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      ]
    }
  ]
}
